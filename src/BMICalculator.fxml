<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="680.0" prefWidth="560.0"
            style="-fx-background-color: #F3F6FB;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.BMICalculatorController">

    <children>
        <VBox alignment="TOP_CENTER" spacing="20"
              AnchorPane.topAnchor="25"
              AnchorPane.bottomAnchor="25"
              AnchorPane.leftAnchor="35"
              AnchorPane.rightAnchor="35">

            <VBox spacing="5">
                <Label text="BMI Calculator"
                       style="-fx-text-fill: #172B4D; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                <Label text="Calculate your Body Mass Index"
                       style="-fx-text-fill: #718096; -fx-font-size: 14px;"/>
            </VBox>

            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22;">
                <Label text="Measurement Units"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #263B5A;"/>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <RadioButton fx:id="metricRadio" text="Metric (kg / cm)"
                                 selected="true" onAction="#selectMetric"/>
                    <RadioButton fx:id="imperialRadio" text="Imperial (lbs / inches)"
                                 onAction="#selectImperial"/>
                </HBox>

                <Separator/>

                <Label text="Height"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TextField fx:id="centimetersInput" promptText="Height in centimeters"
                           prefHeight="42" style="-fx-background-radius: 8;"/>
                <TextField fx:id="inchesInput" promptText="Height in inches"
                           prefHeight="42" style="-fx-background-radius: 8;"
                           visible="false" managed="false"/>

                <Label text="Weight"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TextField fx:id="kilosInput" promptText="Weight in kilograms"
                           prefHeight="42" style="-fx-background-radius: 8;"/>
                <TextField fx:id="poundsInput" promptText="Weight in pounds"
                           prefHeight="42" style="-fx-background-radius: 8;"
                           visible="false" managed="false"/>

                <HBox spacing="12">
                    <Button text="Calculate BMI" onAction="#calculate"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            prefHeight="44"
                            style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;"/>
                    <Button text="Reset" onAction="#reset"
                            prefWidth="100" prefHeight="44"
                            style="-fx-background-color: #E8EEF8; -fx-text-fill: #263B5A; -fx-background-radius: 9; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <VBox spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22;">
                <Label text="Your BMI Result"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #263B5A;"/>

                <TextField fx:id="bmiOutput" text="--"
                           editable="false" alignment="CENTER"
                           prefHeight="65"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2563EB; -fx-background-color: #F3F6FB; -fx-background-radius: 10;"/>

                <Label fx:id="bmiCategory" text="Enter your measurements"
                       alignment="CENTER" maxWidth="Infinity"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #718096; -fx-background-color: #F3F6FB; -fx-background-radius: 8; -fx-padding: 12;"/>

                <Label text="BMI Category Guide"
                       style="-fx-font-weight: bold; -fx-text-fill: #263B5A;"/>

                <VBox spacing="7">
                    <Label text="Underweight       Below 18.5"
                           style="-fx-text-fill: #3B82F6;"/>
                    <Label text="Normal Weight    18.5 – 24.9"
                           style="-fx-text-fill: #16A34A;"/>
                    <Label text="Overweight         25 – 29.9"
                           style="-fx-text-fill: #D97706;"/>
                    <Label text="Obese                   30 and above"
                           style="-fx-text-fill: #DC2626;"/>
                </VBox>
            </VBox>

            <Label text="BMI Calculator • JavaFX Application"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>

        </VBox>
    </children>
</AnchorPane>
